APP_ENV=local
APP_VERSION=0.0.0-phase0
# Hosted pooler: postgresql://postgres.PROJECT_REF:DASHBOARD_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
SUPABASE_URL=
# Optional HS256 fallback. Current Auth tokens are ES256 via JWKS at SUPABASE_URL.
SUPABASE_JWT_SECRET=
# Comma-separated browser origins. Hosted API must include the public site.
CORS_ORIGINS=http://localhost:5173
# Optional. If unset, invite/outcome/digest mail is logged and skipped.
SENDGRID_API_KEY=
PUBLIC_APP_URL=https://www.stufe7.com
# Shared secret for POST /v1/jobs/run and GET /v1/jobs/status (header X-Job-Secret).
JOB_SECRET=
# Optional. Auth-orphan delete and privacy Auth ban. Skip those steps if unset.
SUPABASE_SERVICE_ROLE_KEY=
